# Ethereum node providers (HTTP + WebSocket endpoints).
# At least one provider pair (HTTP + WSS) is required; the bot rotates
# between whichever ones are configured.
HTTP_ALCHEMY=
WSS_ALCHEMY=

HTTP_QUICKNODE=
WSS_QUICKNODE=

HTTP_INFURA=
WSS_INFURA=

HTTP_BLAST=
WSS_BLAST=

HTTP_NODEREAL=
WSS_NODEREAL=

# 1inch Dev Portal API key, used for aggregator quotes in utils/dex.py
ONEINCH_API_KEY=

# Wallet used only to sign/simulate swaps via eth_call (no funds are moved).
# NEVER commit a real private key.
PRIVATE_KEY=
ADDRESS=
